// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM_DAYS
}

enum ExecutionMode {
  DRAFT_ONLY
  SEND_INVOICE
  COMPLETE_NET_TERMS
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  OVERDUE_HOLD
}

enum ExecutionStatus {
  SUCCESS
  SKIPPED_OVERDUE
  FAILED
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  notificationEmail   String?
  defaultTimezone     String   @default("America/New_York")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RecurringSchedule {
  id                  String          @id @default(cuid())
  shop                String
  name                String
  companyId           String
  companyName         String
  companyLocationId   String
  companyLocationName String
  companyContactId    String?
  frequency           Frequency       @default(MONTHLY)
  intervalDays        Int?            // Usado solo cuando frequency == CUSTOM_DAYS
  executionMode       ExecutionMode   @default(DRAFT_ONLY)
  pauseOnOverdue      Boolean         @default(true)
  status              ScheduleStatus  @default(ACTIVE)
  nextRunAt           DateTime
  lastRunAt           DateTime?
  poNumberPrefix      String?
  note                String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  lineItems           ScheduleLineItem[]
  logs                ExecutionLog[]

  @@index([shop, status, nextRunAt])
  @@index([shop, companyLocationId])
}

model ScheduleLineItem {
  id           String            @id @default(cuid())
  scheduleId   String
  variantId    String            // GID: gid://shopify/ProductVariant/...
  productTitle String
  variantTitle String?
  quantity     Int

  schedule     RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model ExecutionLog {
  id                  String          @id @default(cuid())
  scheduleId          String
  shop                String
  status              ExecutionStatus
  shopifyDraftOrderId String?
  shopifyOrderId      String?
  errorMessage        String?
  executedAt          DateTime        @default(now())

  schedule            RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, executedAt])
}